# Use a SANDBOX restricted key (rk_test_...) for development. Never commit real keys.
# In production, load these from your host's secrets vault, not a committed file.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Where Checkout sends customers back to (your WordPress pages)
SITE_URL=https://moregrowglobalsearch.com

# Leave false until check:tax shows an active registration (otherwise Stripe silently collects $0 tax)
STRIPE_TAX_ENABLED=false

PORT=4242
